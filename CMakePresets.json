{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "description": "Windows X86 with MSVC",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_PROJECT_TOP_LEVEL_INCLUDES": "$env{VSINSTALLDIR}Common7/IDE/CommonExtensions/Microsoft/CMake/cmake/Microsoft/SegmentHeap.cmake"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-x64-game-debug terminal",
      "displayName": "Windows x64 Game Debug Terminal",
      "description": "控制台子系统",
      "inherits": "windows-base",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PENFRAMEWORK_CMAKE_WIN_SUBSYSTEM": "Terminal",
        "PENFRAMEWORK_CMAKE_BUILD_TESTS": "OFF",
        "PENFRAMEWORK_CMAKE_TARGET": "Game"
      }
    },
    {
      "name": "windows-x64-game-debug native",
      "displayName": "Windows x64 Game Debug Native",
      "description": "窗口子系统",
      "inherits": "windows-base",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PENFRAMEWORK_CMAKE_WIN_SUBSYSTEM": "Native",
        "PENFRAMEWORK_CMAKE_BUILD_TESTS": "OFF",
        "PENFRAMEWORK_CMAKE_TARGET": "Game"
      }
    }
  ]
}